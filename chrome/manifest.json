{
  "manifest_version": 3,
  "name": "Volume Booster",
  "version": "1.0.0",
  "description": "Amplify the volume of any tab in your browser. Boost the audio output of videos, music, and other media content beyond the default limits.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/dark-16.png",
    "32": "icons/dark-32.png",
    "48": "icons/dark-48.png",
    "128": "icons/dark-128.png"
  },
  "permissions": ["storage", "tabs", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Volume Booster",
    "default_icon": {
      "16": "icons/dark-16.png",
      "32": "icons/dark-32.png",
      "48": "icons/dark-48.png",
      "128": "icons/dark-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
